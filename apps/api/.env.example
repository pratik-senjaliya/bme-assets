# Copy to .env. Never commit .env.

# Local: matches docker-compose.dev.yml. Demo: Supabase pooled connection string.
DATABASE_URL="postgresql://bme:bme@localhost:5432/bme"
# Local: same as above. Demo: Supabase direct connection (used by migrations).
DIRECT_URL="postgresql://bme:bme@localhost:5432/bme"

PORT=4000
# Browser origin allowed by CORS and cookies.
WEB_ORIGIN="http://localhost:3000"
# Decides "today" for the PMS date lock. Set on every install.
APP_TIMEZONE="Asia/Kolkata"

# Phase 1+
JWT_SECRET="change-me-to-a-long-random-string"
# Phase 2+: local | supabase
STORAGE_DRIVER="local"
STORAGE_PATH="./uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
