# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml on the hospital server.

# Password for the database inside Docker. Pick a long random one; it is only used between containers.
DB_PASSWORD=

# Signs login cookies. A long random string (at least 32 characters). Generate with:  openssl rand -base64 48
JWT_SECRET=

# The address staff type in the browser, e.g. http://bme.hospital.local or http://192.168.1.20
PUBLIC_URL=http://localhost

# Port the system listens on (80 is the normal web port).
HTTP_PORT=80

# Decides "today" for PMS dates, reminders and reports.
APP_TIMEZONE=Asia/Kolkata

# true only after you have set up HTTPS (docs/install.md). Leave false for plain HTTP on the LAN.
COOKIE_SECURE=false

# Nightly backups: folder on the server, hour of the night (server time), and how many days to keep.
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
