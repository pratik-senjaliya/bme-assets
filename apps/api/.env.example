# Copy to .env. Never commit .env.

# Local: matches docker-compose.dev.yml. Demo: Supabase pooled connection string.
DATABASE_URL="postgresql://bme:bme@localhost:5432/bme"
# Local: same as above. Demo: Supabase direct connection (used by migrations).
DIRECT_URL="postgresql://bme:bme@localhost:5432/bme"

PORT=4000
# Browser origin allowed by CORS and cookies.
WEB_ORIGIN="http://localhost:3000"
# Decides "today" for the PMS date lock. Set on every install.
APP_TIMEZONE="Asia/Kolkata"

JWT_SECRET="change-me-to-a-long-random-string"
# Session length in hours.
SESSION_HOURS=12
# true only when the site is served over HTTPS (demo). Leave false on a hospital LAN over plain HTTP.
COOKIE_SECURE=false
# Proxy hops in front of the API (Vercel rewrite + Render = 2; on-prem reverse proxy = 1). Used for the audit-log IP.
TRUST_PROXY=1
# Password for the seeded demo logins (npm run db:seed -w apps/api).
SEED_PASSWORD="Demo@1234"

# File storage: local (disk) | supabase
STORAGE_DRIVER="local"
STORAGE_PATH="./uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="bme-files"
