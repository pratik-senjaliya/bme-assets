// All tables from docs/architecture.md. Every table has id, created_at, updated_at, created_by.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Criticality {
  general
  minor
  critical
  most_critical
}

enum AssetStatus {
  active
  not_in_use
  condemned
  transferred // moved permanently to another unit, with HOD approval
}

enum ContractType {
  warranty
  cmc
  amc
  in_house
}

enum AttachmentKind {
  po
  installation_report
  photo
  manual
  certificate
  eol_letter
  contract
  service_report
  invoice
  condemnation_form
  other
}

enum ServiceKind {
  amc_visit
  cmc_visit
  repair
  inspection
  other
}

// Open → In progress (⇄ On hold, by the HOD) → Resolved (downtime stops) → Closed (by whoever raised it, or
// automatically after the hospital's number of days).
enum ComplaintStatus {
  open
  in_progress
  on_hold
  resolved
  closed
}

enum ExpenseType {
  repair
  spare_part
}

enum ApprovalType {
  condemn
  delete
  edit_key_field
  transfer
}

enum ApprovalStatus {
  pending
  approved
  rejected
  withdrawn // taken back by the person who asked
}

// ---------- Setup ----------

model HospitalSettings {
  id               String   @id @default(uuid())
  name             String
  shortCode        String
  assetIdPattern   String   @default("{HOSP}-{DEPT}-{TYPE}-{LOC}-{SEQ:3}")
  patternLocked    Boolean  @default(false)
  reminderDays     Int[]    @default([30, 15, 5])
  // Critical equipment down for longer than this many hours is flagged on complaints and reports.
  criticalDowntimeHours Int   @default(24)
  // A resolved complaint its raiser has not closed closes by itself after this many days (decision B).
  complaintCloseDays    Int   @default(3)
  // Transfers of equipment to another unit of the group: only for hospitals that have other units.
  transfersEnabled      Boolean @default(false)
  // Who the wards call for a broken machine (shown to everyone; e.g. "Biomedical on call: 98250 00000, ext. 214").
  biomedContact         String?
  // Shared ward PCs: sign out after this many minutes without use (0 = never).
  idleLogoutMinutes     Int     @default(30)
  // Counters incremented inside the creating transaction (asset IDs / complaint numbers are never reused).
  assetSeq         Int      @default(0)
  complaintSeq     Int      @default(0)
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPassword     String?
  smtpFrom         String?
  // The last email attempt, shown in Hospital settings so a mail server that stopped working is noticed.
  mailLastSentAt   DateTime?
  mailLastError    String?
  mailLastErrorAt  DateTime?
  // Written by deploy/backup.sh after each nightly backup; the daily job tells the HOD when it failed or stopped.
  backupLastAt      DateTime?
  backupLastError   String?
  backupLastErrorAt DateTime?
  // The address QR labels point at; null = the address they are printed from.
  labelBaseUrl      String?
  // Set by the daily job each time it runs, so a stopped job shows (health, Hospital settings).
  dailyJobLastRunAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?

  @@map("hospital_settings")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  locations  Location[]
  users      User[]
  assets     Asset[]
  complaints Complaint[]
  issued     ConsumableMovement[]

  @@map("departments")
}

model Location {
  id           String   @id @default(uuid())
  departmentId String
  name         String
  code         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  department Department @relation(fields: [departmentId], references: [id])
  assets     Asset[]

  @@unique([departmentId, name])
  @@map("locations")
}

model EquipmentType {
  id                       String   @id @default(uuid())
  name                     String   @unique
  code                     String   @unique
  defaultPmsMonths         Int?
  defaultCalibrationMonths Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  createdBy                String?

  assets       Asset[]
  pmsTemplates PmsTemplate[]

  @@map("equipment_types")
}

// ---------- Access ----------

model Role {
  id        String   @id @default(uuid())
  name      String   @unique // super_admin, admin, biomed, nursing
  label     String
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  code      String   @unique // asset.create, asset.edit_key, complaint.resolve, ...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  // Optional short sign-in name (lowercase), for staff without an email of their own.
  username     String?  @unique
  passwordHash String
  // Set when the HOD gives or resets the password: the person must choose their own before anything else.
  mustChangePassword Boolean @default(false)
  // Deputy HOD (biomedical staff only): DEPUTY_PERMISSIONS on top of the role.
  deputy       Boolean  @default(false)
  roleId       String
  departmentId String? // required for nursing users
  active       Boolean  @default(true)
  // Raised when the password changes; sessions signed with an older value stop working.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  complaintsRaised Complaint[] @relation("ComplaintRaisedBy")
  complaintsAssigned Complaint[] @relation("ComplaintAssignedTo")
  notifications    Notification[]
  stockMovements   ConsumableMovement[]

  @@map("users")
}

// ---------- Assets ----------

model Asset {
  id                   String      @id @default(uuid())
  assetCode            String      @unique
  sequenceNo           Int
  equipmentTypeId      String
  name                 String
  make                 String?
  model                String?
  serialNo             String?
  // The hospital\'s own inventory tag from before this system.
  tagNo                String?
  departmentId         String
  locationId           String
  criticality          Criticality @default(minor)
  status               AssetStatus @default(active)
  installationDate     DateTime?   @db.Date
  warrantyMonths       Int?
  warrantyEnd          DateTime?   @db.Date
  pmsFrequencyMonths   Int?
  // Only when this machine is calibrated more or less often than its equipment type.
  calibrationFrequencyMonths Int?
  nextPmsDue           DateTime?   @db.Date
  nextCalibrationDue   DateTime?   @db.Date
  // The last PMS / calibration failed: the machine is flagged until one passes (cleared by a passing record).
  pmsFailedOn          DateTime?   @db.Date
  calibrationFailedOn  DateTime?   @db.Date
  // Last PMS / calibration done before this system was used. Set once when existing equipment is registered;
  // the first due date runs from it. Never a PMS record, so the PMS date lock is untouched.
  openingPmsOn         DateTime?   @db.Date
  openingCalibrationOn DateTime?   @db.Date
  // Who sold it (often a distributor) and who services it, from the suppliers directory. The make stays as text.
  supplierId           String?
  serviceVendorId      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?

  supplier           Vendor?             @relation("AssetSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  serviceVendor      Vendor?             @relation("AssetServiceVendor", fields: [serviceVendorId], references: [id], onDelete: Restrict)
  equipmentType      EquipmentType       @relation(fields: [equipmentTypeId], references: [id])
  department         Department          @relation(fields: [departmentId], references: [id])
  location           Location            @relation(fields: [locationId], references: [id])
  purchaseOrders     PurchaseOrder[]
  serviceContracts   ServiceContract[]
  pmsRecords         PmsRecord[]
  calibrationRecords CalibrationRecord[]
  complaints         Complaint[]
  expenses           ServiceExpense[]
  serviceLogs        ServiceLog[]
  notifications      Notification[]
  consumablesIssued  ConsumableMovement[]

  @@index([departmentId])
  @@index([status])
  @@map("assets")
}

model PurchaseOrder {
  id        String   @id @default(uuid())
  assetId   String
  poNumber  String
  poDate    DateTime @db.Date
  vendor    String
  cost      Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("purchase_orders")
}

model ServiceContract {
  id        String       @id @default(uuid())
  assetId   String
  type      ContractType
  vendor    String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  cost      Decimal?     @db.Decimal(12, 2)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  createdBy String?

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("service_contracts")
}

model Attachment {
  id        String         @id @default(uuid())
  ownerType String // asset, purchase_order, complaint, calibration_record, ...
  ownerId   String
  kind      AttachmentKind
  fileName  String         @default("") // original name, shown to users
  filePath  String // storage key, generated by the server
  mime      String
  size      Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  createdBy String?

  @@index([ownerType, ownerId])
  @@map("attachments")
}

// ---------- PMS ----------

model PmsTemplate {
  id              String   @id @default(uuid())
  equipmentTypeId String
  version         Int
  schema          Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?

  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])
  records       PmsRecord[]

  @@unique([equipmentTypeId, version])
  @@map("pms_templates")
}

model PmsRecord {
  id               String    @id @default(uuid())
  assetId          String
  // In-house: the hospital's checklist, dated today by the server (rule 1). OEM: done by the manufacturer's engineer,
  // dated from their report within the limits of decision A, with the report attached; our checklist is optional.
  kind             String    @default("in_house") // in_house | oem
  serviceBy        String? // OEM: the engineer and company, as on the report
  templateId       String? // null: an OEM PMS without our checklist
  performedOn      DateTime  @db.Date // in-house: stamped by the server; OEM: the visit date, checked by the server
  performedBy      String // who entered it
  answers          Json
  result           String
  submittedAt      DateTime  @default(now())
  locked           Boolean   @default(true)
  correctsRecordId String?
  correctionReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?

  asset      Asset       @relation(fields: [assetId], references: [id])
  template   PmsTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict) // records keep their checklist
  corrects   PmsRecord?  @relation("PmsCorrection", fields: [correctsRecordId], references: [id])
  corrections PmsRecord[] @relation("PmsCorrection")

  @@index([assetId])
  @@map("pms_records")
}

// ---------- Calibration ----------

model CalibrationRecord {
  id        String   @id @default(uuid())
  assetId   String
  doneOn    DateTime @db.Date
  dueOn     DateTime @db.Date
  agency    String
  result    String
  // A record entered wrongly is replaced by one correction that points at it (the original stays, marked).
  correctsRecordId String?  @unique
  correctionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  asset       Asset              @relation(fields: [assetId], references: [id])
  corrects    CalibrationRecord? @relation("CalibrationCorrection", fields: [correctsRecordId], references: [id])
  correctedBy CalibrationRecord? @relation("CalibrationCorrection")

  @@index([assetId])
  @@map("calibration_records")
}

// ---------- Complaints & expenses ----------

model Complaint {
  id              String          @id @default(uuid())
  complaintNo     String          @unique
  assetId         String
  raisedById      String
  departmentId    String
  description     String
  // The machine cannot be used or patient care is affected: listed first, and emailed to the biomedical team.
  urgent          Boolean         @default(false)
  status          ComplaintStatus @default(open)
  raisedAt        DateTime        @default(now())
  startedAt       DateTime?
  startedBy       String?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  // Who is to fix it (HOD's assignment, an engineer taking it, or whoever started work). assignedBy is a plain id
  // like startedBy; the history of changes is in the audit log.
  assignedToId    String?
  assignedAt      DateTime?
  assignedBy      String?
  // Escalated to the HOD and not yet acted on (put on hold or back to work): set by escalating, cleared by the HOD.
  escalatedAt     DateTime?
  escalatedBy     String?
  // Why it is on hold now (e.g. the OEM engineer's visit); the history of holds is in complaint_steps.
  holdNote        String?
  // Closed by whoever raised it; closedBy is null when it closed by itself or with a condemnation.
  closedAt        DateTime?
  closedBy        String?
  closeNote       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?

  asset      Asset            @relation(fields: [assetId], references: [id])
  raisedBy   User             @relation("ComplaintRaisedBy", fields: [raisedById], references: [id])
  assignedTo User?            @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])
  expenses   ServiceExpense[]
  steps      ComplaintStep[]
  consumables ConsumableMovement[]

  @@index([assetId])
  @@index([departmentId])
  @@index([assignedToId])
  @@map("complaints")
}

// The steps of a complaint that carry a note and can happen more than once: started, escalated, held, resumed,
// closed. Raised, assigned and resolved live on the complaint itself. Append-only, like the audit log.
model ComplaintStep {
  id          String   @id @default(uuid())
  complaintId String
  kind        String // started | escalated | held | resumed | closed
  note        String?
  at          DateTime @default(now())
  by          String? // null: done by the system (closed automatically, condemnation)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_steps")
}

model ServiceExpense {
  id          String      @id @default(uuid())
  assetId     String
  complaintId String?
  type        ExpenseType
  description String
  amount      Decimal     @db.Decimal(12, 2)
  date        DateTime    @db.Date
  vendor      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   String?

  asset     Asset      @relation(fields: [assetId], references: [id])
  complaint Complaint? @relation(fields: [complaintId], references: [id])

  @@map("service_expenses")
}

// ---------- Workflow ----------

model ApprovalRequest {
  id          String         @id @default(uuid())
  type        ApprovalType
  targetType  String
  targetId    String
  payload     Json
  requestedBy String
  status      ApprovalStatus @default(pending)
  decidedBy   String?
  decidedAt   DateTime?
  reason      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?

  @@index([status])
  @@map("approval_requests")
}

model Notification {
  id            String    @id @default(uuid())
  userId        String?
  role          String? // used when the notification targets a whole role
  type          String
  assetId       String?
  // The complaint a complaint notice is about, so the bell opens it (a plain id: a deleted complaint leaves it dangling).
  complaintId   String?
  dueDate       DateTime? @db.Date
  thresholdDays Int?
  message       String
  readAt        DateTime?
  emailedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?

  user  User?  @relation(fields: [userId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])

  // One reminder per person per item per threshold, however often the job runs.
  @@unique([userId, type, assetId, dueDate, thresholdDays], map: "notification_dedupe")
  @@index([userId])
  @@map("notifications")
}

// ---------- Audit (insert-only) ----------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------- Service log ----------

// Service that is not a breakdown: an AMC/CMC vendor visit, an in-house repair, an inspection. Entered by hand
// (the meeting: "when it happened and what was done"); the date cannot be in the future. Documents (the service
// report) attach through `attachments` with ownerType "service_log".
model ServiceLog {
  id          String      @id @default(uuid())
  assetId     String
  serviceDate DateTime    @db.Date
  kind        ServiceKind
  vendor      String?
  description String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   String?

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("service_logs")
}

// The monthly management report as it was on the 1st of the next month: what the HOD was sent. Kept as the report's
// data (figures, charts, tables), so it reads the same later even if records are corrected meanwhile, and can be
// downloaded again as PDF or Excel. One per month; the unique month makes a second save impossible.
model MonthlyReport {
  id        String   @id @default(uuid())
  month     String   @unique // YYYY-MM
  data      Json
  createdAt DateTime @default(now())

  @@map("monthly_reports")
}

// Suppliers directory: the companies that sell and service equipment (manufacturers, distributors, service
// agencies), each with the people to call. A company in use by equipment cannot be deleted.
model Vendor {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  contacts VendorContact[]
  supplied Asset[]         @relation("AssetSupplier")
  serviced Asset[]         @relation("AssetServiceVendor")
  deliveries ConsumableMovement[]

  @@map("vendors")
}

model VendorContact {
  id       String  @id @default(uuid())
  vendorId String
  name     String
  role     String? // e.g. Service engineer, Sales
  phone    String?
  email    String?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_contacts")
}

// ---------- Consumables ----------

// Something kept in stock and given out (probes, leads, batteries...). `stock` is kept in step with the movements in
// the same transaction and never goes below zero. Item names are unique whatever the capitals (index in SQL).
model ConsumableItem {
  id           String   @id @default(uuid())
  name         String
  unit         String   @default("pcs")
  stock        Int      @default(0)
  reorderLevel Int      @default(0)
  unitCost     Decimal? @db.Decimal(12, 2) // the latest price paid, or as entered
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  movements ConsumableMovement[]

  @@map("consumable_items")
}

enum ConsumableKind {
  in
  out
  adjust
}

// One stock movement, never changed afterwards: in (a purchase), out (issued to a department, perhaps for a machine
// or a complaint) or adjust (a count that differed from the books). quantity is signed: + into stock, - out.
model ConsumableMovement {
  id           String         @id @default(uuid())
  itemId       String
  kind         ConsumableKind
  quantity     Int
  stockAfter   Int
  date         DateTime       @db.Date
  unitCost     Decimal?       @db.Decimal(12, 2) // in: the price paid; out: the item's cost at the time
  supplierId   String?
  reference    String? // invoice or PO number
  departmentId String?
  assetId      String?
  complaintId  String?
  reason       String?
  createdAt    DateTime       @default(now())
  createdBy    String

  item       ConsumableItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplier   Vendor?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  asset      Asset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  complaint  Complaint?     @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  by         User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([date])
  @@index([assetId])
  @@map("consumable_movements")
}
